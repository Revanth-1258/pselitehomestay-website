# ==============================================================================
# PS ELITE HOMESTAY TIRUPATI - ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings -> Environment Variables.

# 1. Base Application Domain URL (Canonical URL & Open Graph)
NEXT_PUBLIC_SITE_URL=https://pselitehomestays.com

# 2. Receptionist & Admin Portal Desk Email (for FormSubmit Instant Notifications)
NEXT_PUBLIC_ADMIN_NOTIFY_EMAIL=pselitehomestays@gmail.com

# 3. Direct Support & Booking WhatsApp Contact Numbers
NEXT_PUBLIC_PRIMARY_PHONE=+919392739715
NEXT_PUBLIC_SECONDARY_PHONE=+919440311716

# 4. Optional: Supabase Storage / CDN URL prefix for Image Gallery Assets
# Images are hosted on Supabase Storage Bucket 'websites-data'
NEXT_PUBLIC_STORAGE_CDN_URL=https://yralcgckodgemrozhvhn.supabase.co/storage/v1/object/public/websites-data/logo

# 5. Database Connectors (Supabase or Firebase Firestore)
# Note: If neither is configured, the system uses a free ExtendsClass JSON storage bucket automatically.

# Option A: Supabase Database Configuration
# Set these to save bookings and pricing to your own Supabase PostgreSQL database
# (Requires a table named 'ps_elite_store' with schema: id TEXT PRIMARY KEY, data JSONB NOT NULL)
# NEXT_PUBLIC_SUPABASE_URL=https://yralcgckodgemrozhvhn.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Option B: Firebase Firestore Configuration (Server-Side Admin SDK)
# Set these to save bookings and pricing to Firebase Firestore (saves to 'ps_elite_store/global')
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ..."

