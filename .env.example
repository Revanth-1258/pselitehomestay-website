# ==============================================================================
# PS ELITE HOMESTAY TIRUPATI - ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings -> Environment Variables.

# 1. Base Application Domain URL (Canonical URL & Open Graph)
NEXT_PUBLIC_SITE_URL=https://pselitehomestays.com

# 2. Receptionist & Admin Portal Desk Email (for FormSubmit Instant Notifications)
NEXT_PUBLIC_ADMIN_NOTIFY_EMAIL=pselitehomestays@gmail.com

# 3. Direct Support & Booking WhatsApp Contact Numbers
NEXT_PUBLIC_PRIMARY_PHONE=+919392739715
NEXT_PUBLIC_SECONDARY_PHONE=+919440311716

# 4. Optional: Supabase Storage / CDN URL prefix for Image Gallery Assets
# Images are hosted on Supabase Storage Bucket 'websites-data'
NEXT_PUBLIC_STORAGE_CDN_URL=https://yralcgckodgemrozhvhn.supabase.co/storage/v1/object/public/websites-data/logo

# 5. PRIVATE storage for bookings & inventory (server-only, REQUIRED in production)
# Guest bookings contain names, phones, emails and payment refs, so they must live in
# private storage. The first configured option below is used.

# Option A (simplest on Vercel): Vercel Marketplace -> Upstash Redis -> connect to this project.
# Vercel adds these automatically:
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx

# Option B: Firebase Firestore (Admin SDK). Saves to 'ps_elite_store/global'.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
..."

# Option C: Supabase with the SERVICE ROLE key (never the anon key, never NEXT_PUBLIC_).
# Table 'ps_elite_store' (id TEXT PRIMARY KEY, data JSONB NOT NULL) with RLS ENABLED and no anon policies.
# SUPABASE_URL=https://yralcgckodgemrozhvhn.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# 6. Admin / Owner portal login (server-side, REQUIRED)
# Long random passkeys. Change them by editing these values and redeploying.
# ADMIN_PASSKEY=
# OWNER_PASSKEY=
# Random string, at least 32 characters, used to sign login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
